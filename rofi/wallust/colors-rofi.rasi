 /* wallust template - colors-rofi */

* {
active-background: #344D9A;
active-foreground: #CEEDFB;
normal-background: #2D2330;
normal-foreground: #CEEDFB;
urgent-background: #2D74C2;
urgent-foreground: #CEEDFB;

alternate-active-background: #063F7D;
alternate-active-foreground: #CEEDFB;
