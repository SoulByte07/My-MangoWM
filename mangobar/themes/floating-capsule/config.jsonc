{
    "layer": "top",
    "height": 38,
    "width": 800,
    "buffer-scale": 1,
    "modules-left": [
        "workspaces"
    ],
    "modules-center": [
        "clock#time"
    ],
    "modules-right": [
        "layout",
        "custom/hypridle",
        "custom/menu"
    ],
    "workspaces": {
        "hide-empty": true,
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle",
        "scroll-interval": 100,
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client",
        "tag-names": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8",
            "9"
        ],
        "format-icons": {
            "active": "󰮯",
            "empty": "●",
            "occupied": "󰊠",
            "default": "󰊠"
        },
        "pinned": [
            1,
            2,
            3,
            4,
            5
        ]
    },
    "layout": {
        "format": "{}",
        "format-icons": {
            "tile": "󰨑",
            "T": "󰨑",
            "master": "󰨑",
            "scroller": "",
            "S": ""
        }
    },
    "window": {
        "format": "{}",
        "max-length": 40
    },
    "clock#time": {
        "format": "  {:L%I:%M }"
    },
    "custom/hypridle": {
        "format": "{}",
        "exec": "bash ~/.config/mango/scripts/HypridleIndicator.sh status",
        "interval": 5,
        "signal": 9,
        "on-click": "bash ~/.config/mango/scripts/HypridleIndicator.sh toggle",
        "on-click-right": "bash ~/.config/mango/scripts/LockScreen.sh"
    },
    "custom/menu": {
        "format": "   ",
        "on-click": "bash ~/.config/mango/scripts/RofiLauncher.sh"
    }
}
