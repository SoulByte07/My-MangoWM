alternate-urgent-background: #2D2330;
alternate-urgent-foreground: #CEEDFB;

selected-active-background: #2D74C2;
selected-active-foreground: #CEEDFB;
selected-normal-background: #2D74C2;
selected-normal-foreground: #CEEDFB;
selected-urgent-background: #344D9A;
selected-urgent-foreground: #CEEDFB;

background-color: #2D2330;
background: rgba(0,0,0,0.7);
foreground: #CEEDFB;
border-color: #344D9A;

color0: #534957;
