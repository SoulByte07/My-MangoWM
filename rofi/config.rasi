/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* dKoolDots - Default

* All main themes or configs are located in ~/.config/mango/rofi/themes/
* If you want to edit the config, that is where you should edit NOT here

* To load a new theme, manually edit the file path below or choose desired theme via rofi theme selector (choose via app menu)

* Alternative way to Load (preferred) own cooked by Ja
* SUPER CTRL R - Choose style & SUPER CTRL SHIFT R

* TIPS
* If you have edited a config, rename it with a unique name. During update, the contents of
* ~/.config/mango/rofi/themes/ will be replaced. */

/* ---- Global Configuration Fonts ---- */
@import "~/.config/mango/rofi/0-shared-fonts.rasi"

/* Force kitty as terminal for Terminal=true apps and run-shell */
@import "~/.config/mango/rofi/00-terminal.rasi"

/* note: Main themes in ~/.config/mango/rofi/themes */
/* You can manually change here or you can use rofi theme selector SUPER SHIFT E */

configuration {
    /* Turns on fuzzy matching for your keystrokes */
    matching: "fuzzy";
    /* Tells Rofi to sort the results */
    sort: true;
    /* Uses the fzf algorithm to rank the best matches */
    sorting-method: "fzf";
}


@theme "~/.config/mango/rofi/themes/KooL_style-4.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-4.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-4.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-5.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-6.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-3-Fullscreen-v2.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-4.rasi"
@theme "~/.config/mango/rofi/themes/KooL_style-4.rasi"
@theme "~/.config/mango/rofi/themes/KooL_Catppuccin_mocha.rasi"
@theme "~/.config/mango/rofi/themes/KooL_Catppuccin_mocha.rasi"
@theme "~/.config/mango/rofi/themes/rounded-nord-dark.rasi"
